# TalkenFi environment variables.
# Local: copy this file to .env (or .env.local) and restart `npm run dev`.
# Vercel: Project → Settings → Environment Variables (Production + Preview), then redeploy.

# Required in production. Reown AppKit project ID from https://dashboard.reown.com
# (Project → Project ID). Enables WalletConnect: QR code and mobile wallets such as Phantom mobile.
# Browser extension wallets still work without it. Public by design (embedded in the browser bundle).
VITE_REOWN_PROJECT_ID=
